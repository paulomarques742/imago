    <string name="library_welcome_question">Where are your photos?</string>
    <string name="library_welcome_device_title">Just this device</string>
    <string name="library_welcome_device_body">Edit the photos and videos saved on this device. Next, IMAGO asks for access to them.</string>
    <string name="library_welcome_computer_title">Just this computer</string>
    <string name="library_welcome_computer_body">Edit photos from folders on this computer. Next, choose the first folder.</string>
    <string name="library_welcome_immich_title">Connect an Immich server</string>
    <string name="library_welcome_immich_body">Browse your Immich library and send your edits back to it. Your photos stay on your server.</string>
    <string name="library_welcome_later">You can add the other option later in Settings.</string>
    <!-- The Immich API key permissions -->
    <string name="library_key_permissions_title">Which permissions does the key need?</string>
    <string name="library_key_permissions_where">Create the key in Immich, in your account settings under API keys, and tick at least the required permissions.</string>
    <string name="library_key_permissions_required">Required, to show and edit your library</string>
    <string name="library_key_permissions_optional">Optional</string>
    <string name="library_key_permissions_optional_note">Leave any of these out and only what it does stops working. IMAGO tells you which one is missing when you try it.</string>
    <string name="library_key_permissions_all">Choosing “all” also works, but it gives the key more access than IMAGO uses.</string>
    <string name="library_permission_user_read">Checks which account the key belongs to, so the same library isn’t added twice</string>
    <string name="library_permission_asset_read">Lists the timeline, searches, and reads each photo’s details</string>
    <string name="library_permission_asset_view">Loads thumbnails and previews, and plays videos</string>
    <string name="library_permission_asset_download">Opens the full-resolution original to edit and export</string>
    <string name="library_permission_album_read">Shows your albums</string>
    <string name="library_permission_asset_upload">Sends exported photos, compositions and what you share with IMAGO to the server</string>
    <string name="library_permission_stack_create">Stacks each exported edit with its original</string>
    <string name="library_permission_asset_update">Marks and unmarks favorites</string>
    <string name="library_permission_asset_delete">Deletes the photos you ask it to delete</string>
