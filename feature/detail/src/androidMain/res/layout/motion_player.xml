<?xml version="1.0" encoding="utf-8"?>
<!--
  The movement of a Live Photo, over the photo. A texture and a clear shutter, because the surface type
  and the shutter colour can only be chosen when the view is inflated: a surface view would show black
  until the first frame, where the photo should still be.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:use_artwork="false"
    app:show_buffering="never"
    app:resize_mode="fit"
    app:shutter_background_color="@android:color/transparent" />
