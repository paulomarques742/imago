<?xml version="1.0" encoding="utf-8"?>
<!--
  The detail's video. A texture and not a surface, because the video is turned by turning the view
  (the recipe's rotation) and a surface view cannot be turned; the surface type can only be chosen when
  the view is inflated.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:use_artwork="false"
    app:show_buffering="when_playing"
    app:resize_mode="fit" />
